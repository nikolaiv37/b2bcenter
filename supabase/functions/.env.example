# Supabase Edge Function secrets — LOCAL development template.
#
# Copy this file to `supabase/functions/.env` (git-ignored) and fill in real
# values, then run:
#   supabase functions serve --env-file supabase/functions/.env
#
# These are SERVER-ONLY secrets. Never prefix them with VITE_ and never
# reference them from frontend code — that would ship them to the browser.

# AES-256-GCM key material for encrypting tenant Econt credentials at rest.
# Any high-entropy string works (it is SHA-256 hashed before use), e.g.:
#   openssl rand -base64 48
# Rotating this value makes already-stored encrypted credentials undecryptable.
ECONT_CREDENTIALS_ENCRYPTION_KEY=

# Optional: set to "true" to enable verbose, PII-free Econt debug logging.
# ECONT_DEBUG=false
